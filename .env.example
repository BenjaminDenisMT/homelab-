# ─────────────────────────────────────────────────────────────────────────────
# .env.example  –  81 Logan homelab
# Copy to .env and fill in your values.
# All settings have sensible defaults; only uncomment lines you need to change.
# ─────────────────────────────────────────────────────────────────────────────

# ── MQTT (Mosquitto) ──────────────────────────────────────────────────────────
# MQTT_HOST=192.168.1.23
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# ── Home Assistant ─────────────────────────────────────────────────────────────
# HA_BASE_URL=http://192.168.1.23:8123
# HA_TOKEN=<long-lived access token from HA profile page>

# ── RTL-SDR ───────────────────────────────────────────────────────────────────
# RTLSDR_METER_ID=1279204985
# RTLSDR_PROTOCOL=scm+
# RTLSDR_SAMPLE_RATE=2048000
# RTLSDR_CENTER_FREQ_HZ=912600155
# RTLSDR_FILTER_ID=1279204985

# ── Mini-splits (Carrier 38MGRQ24C-3) ────────────────────────────────────────
# MINISPLIT_CHAMBRE_IP=192.168.1.49
# MINISPLIT_CUISINE_IP=192.168.1.50
# MINISPLIT_HUMIDITY_DRY_THRESHOLD=50.0
# MINISPLIT_HUMIDITY_COOL_THRESHOLD=50.0

# ── HydroQC ───────────────────────────────────────────────────────────────────
# HYDROQC_TOTAL_CONSUMPTION_SENSOR=sensor.hydro_quebec_maison_total_consumption
# HYDROQC_BILL_TOTAL_SENSOR=sensor.hydro_quebec_maison_bill_total_to_date
